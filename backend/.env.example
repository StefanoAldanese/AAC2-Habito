# Copy this file to .env and fill in the values. Never commit .env.

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# true for local development, false in production (turns on HTTPS-only)
DEBUG=true

# Comma-separated hostnames the server answers to
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty for SQLite (db.sqlite3 in the project folder).
# PostgreSQL example: postgres://habito:secret@localhost:5432/habito
DATABASE_URL=

# How push notifications are sent: console (print), memory (tests) or apns
HABITO_PUSH_BACKEND=console

# Only needed when HABITO_PUSH_BACKEND=apns. From the Apple Developer account.
APNS_AUTH_KEY_PATH=
APNS_AUTH_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_USE_SANDBOX=true

# Rate limits (DRF format: number/period, period in s, m, h or d)
THROTTLE_JOIN=10/15m
THROTTLE_LOGIN=5/15m

LOG_LEVEL=INFO
